@Metadata.layer: #CORE
@UI:{
    headerInfo: { typeName: 'Files Upload',
                  typeNamePlural: 'Uuid',
                  title: { value: 'Uuid' }
    },
    presentationVariant: [{ sortOrder: [{ by: 'Uuid', direction: #DESC }] }]
}
annotate view ZJP_C_FILE_FI
    with 
{

  @UI.facet          : [
   {
   id                 : 'General',
   purpose            : #STANDARD,
   position           : 10,
   
   label              : 'General',
   type               : #IDENTIFICATION_REFERENCE
   },
   {
   id                 : 'Items',
   purpose            : #STANDARD,
   type               : #LINEITEM_REFERENCE,
   label              : 'Items',
   position           : 20,
   targetElement      : '_DataFile'
   }
   ]
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @EndUserText.label: 'Key Uuid'
  Uuid;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @EndUserText.label: 'End User'
  EndUser;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @EndUserText.label: 'Record'
  Zcnt;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @EndUserText.label: 'Status'
  Status;

  @UI.lineItem: [{ position: 50 , label: 'Attachment'}]
  @UI.identification: [{ position: 50 }]
  @EndUserText.label: 'Attachment'
  Attachment;

  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  @EndUserText.label: 'Mimetype'
  Mimetype;

  @UI.lineItem: [{ position: 70 }]
  @UI.identification: [{ position: 70 }]
  @UI.selectionField: [{ position: 70 }]
  @EndUserText.label: 'Filename'
  Filename;

  @UI.lineItem: [{ position: 80 }]
  @UI.identification: [{ position: 80 }]
  @UI.selectionField: [{ position: 80 }]
  @EndUserText.label: 'Created by'
  Createdbyuser;

  @UI.lineItem: [{ position: 90 }]
  @UI.identification: [{ position: 90 }]
  @UI.selectionField: [{ position: 90 }]
  @EndUserText.label: 'Created Date'
  Createddate;

  @UI.lineItem: [{ position: 100 }]
  @UI.identification: [{ position: 100 }]
  @UI.selectionField: [{ position: 100 }]
  @EndUserText.label: 'Changed by'
  Changedbyuser;

  @UI.lineItem: [{ position: 110 }]
  @UI.identification: [{ position: 110 }]
  @UI.selectionField: [{ position: 110 }]
  @EndUserText.label: 'Changed Date'
  Changeddate;
      
}